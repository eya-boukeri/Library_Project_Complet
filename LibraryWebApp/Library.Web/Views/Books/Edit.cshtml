@model Library.BL.DTOs.UpdateBookDto
@{ ViewData["Title"] = "Modifier le livre"; }

<div class="page-hero">
  <div class="page-hero-text">
    <div class="page-eyebrow">Collection</div>
    <h1 class="page-title">Modifier le livre</h1>
  </div>
  <a asp-action="Index" class="btn btn-outline">← Retour</a>
</div>

<div class="form-card">
  <div class="form-card-header"><h2>Modifier : @Model.Title</h2></div>
  <div class="form-card-body">
    <form asp-action="Edit" method="post" enctype="multipart/form-data">
      @Html.AntiForgeryToken()
      <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
      <input asp-for="Id" type="hidden"/>
      <input asp-for="CoverImageUrl" type="hidden"/>
      <div class="form-grid">
        <div class="form-group full">
          <label class="form-label" asp-for="Title"></label>
          <input asp-for="Title" class="form-control"/>
          <span asp-validation-for="Title" class="field-error"></span>
        </div>
        <div class="form-group full">
          <label class="form-label" asp-for="Author"></label>
          <input asp-for="Author" class="form-control"/>
          <span asp-validation-for="Author" class="field-error"></span>
        </div>
        <div class="form-group">
          <label class="form-label" asp-for="ISBN"></label>
          <input asp-for="ISBN" class="form-control mono"/>
        </div>
        <div class="form-group">
          <label class="form-label" asp-for="Genre"></label>
          <input asp-for="Genre" class="form-control"/>
        </div>
        <div class="form-group">
          <label class="form-label" asp-for="PublicationYear"></label>
          <input asp-for="PublicationYear" type="number" class="form-control"/>
        </div>
        <div class="form-group">
          <label class="form-label" asp-for="Publisher"></label>
          <input asp-for="Publisher" class="form-control"/>
        </div>
        <div class="form-group full">
          <label class="form-label" asp-for="CoverImageFile"></label>
          <input asp-for="CoverImageFile" type="file" class="form-control" accept=".jpg,.jpeg,.png,.webp,.gif,image/*"/>
          <small class="text-muted">Choisissez une nouvelle image pour remplacer la couverture actuelle.</small>
          <span asp-validation-for="CoverImageFile" class="field-error"></span>
          @if (!string.IsNullOrEmpty(Model.CoverImageSrc))
          {
            <div style="margin-top:.75rem;display:flex;align-items:center;gap:.75rem">
              <img src="@Url.Content(Model.CoverImageSrc)" alt="Couverture actuelle" style="width:72px;height:104px;object-fit:cover;border-radius:4px;border:1px solid rgba(201,168,76,.2)" />
              <span class="text-muted">Couverture actuelle</span>
            </div>
          }
        </div>
        <div class="form-group full">
          <label class="form-label" asp-for="Description"></label>
          <textarea asp-for="Description" class="form-control"></textarea>
        </div>
        <div class="form-group">
          <label class="form-label">
            <input asp-for="IsAvailable" type="checkbox" style="margin-right:.5rem"/>
            Disponible
          </label>
        </div>
      </div>
      <div class="form-actions">
        <button type="submit" class="btn btn-gold btn-lg">✓ Enregistrer</button>
        <a asp-action="Index" class="btn btn-outline">Annuler</a>
      </div>
    </form>
  </div>
</div>
