@model Library.BL.DTOs.CreateBorrowingDto
@{ ViewData["Title"] = "Nouvel emprunt"; }

<div class="page-hero">
  <div class="page-hero-text">
    <div class="page-eyebrow">Gestion</div>
    <h1 class="page-title">Enregistrer un emprunt</h1>
  </div>
  <a asp-action="Index" class="btn btn-outline">← Retour</a>
</div>

<div class="form-card">
  <div class="form-card-header"><h2>Informations de l'emprunt</h2></div>
  <div class="form-card-body">
    <form asp-action="Create" method="post">
      @Html.AntiForgeryToken()
      <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
      <div class="form-grid">
        <div class="form-group full">
          <label class="form-label">Livre disponible</label>
          <select asp-for="BookId" class="form-control">
            <option value="">— Sélectionner un livre —</option>
            @foreach (var book in (List<Library.BL.DTOs.BookDto>)ViewBag.Books)
            {
              <option value="@book.Id" selected="@(Model.BookId == book.Id)">
                @book.Title — @book.Author @(book.PublicationYear.HasValue ? $"({book.PublicationYear})" : "")
              </option>
            }
          </select>
          <span asp-validation-for="BookId" class="field-error"></span>
        </div>
        <div class="form-group">
          <label class="form-label" asp-for="BorrowerName"></label>
          <input asp-for="BorrowerName" class="form-control" placeholder="Nom complet"/>
          <span asp-validation-for="BorrowerName" class="field-error"></span>
        </div>
        <div class="form-group">
          <label class="form-label" asp-for="BorrowerEmail"></label>
          <input asp-for="BorrowerEmail" type="email" class="form-control" placeholder="email@exemple.com"/>
          <span asp-validation-for="BorrowerEmail" class="field-error"></span>
        </div>
        <div class="form-group">
          <label class="form-label" asp-for="DueDate"></label>
          <input asp-for="DueDate" type="date" class="form-control"/>
          <span asp-validation-for="DueDate" class="field-error"></span>
        </div>
        <div class="form-group full">
          <label class="form-label" asp-for="Notes"></label>
          <textarea asp-for="Notes" class="form-control" placeholder="Notes ou remarques…"></textarea>
        </div>
      </div>
      <div class="form-actions">
        <button type="submit" class="btn btn-gold btn-lg">◎ Enregistrer l'emprunt</button>
        <a asp-action="Index" class="btn btn-outline">Annuler</a>
      </div>
    </form>
  </div>
</div>
